# 복사해서 .env 로 사용: cp .env.example .env
# 용어: 환경변수(environment variable) / 시크릿(secret)
#   - .env 는 절대 커밋하지 않는다 (.gitignore 확인).
#   - "코드에는 설정을 넣지 않고, 실행 환경에서 주입한다"가 핵심.

NODE_ENV=development
PORT=3000

# docker-compose.yml 의 MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE 와 맞춰야 한다.
DATABASE_URL="mysql://app:app1234@localhost:3306/seat_reservation"

# 비즈니스 규칙 (docs/DOMAIN.md R4). "오늘"을 어느 타임존 기준으로 볼지와, 며칠 앞까지 예약을 받을지.
APP_TIMEZONE=Asia/Seoul
RESERVATION_WINDOW_DAYS=14

# TODO [3단계] 인증 구현 시 사용. 실제 값은 충분히 긴 랜덤 문자열로.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
